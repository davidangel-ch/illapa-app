# Local Alchemy dev loads this schema with Varlock and supplies Worker bindings.
# Dokploy's Node services read process.env through packages/node-runtime.
# Node images do not run Varlock: set values in Dokploy; schema defaults do not apply.
# Gitignored .env files hold local secrets; APP_ENV selects local env overrides.
# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$APP_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production)
APP_ENV=development

# @public @type=url
BETTER_AUTH_URL=http://localhost:3000

# Generate with: openssl rand -base64 32
# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# Comma-separated list of browser origins trusted for CORS and better-auth
# (web app, previews, marketing...). Native schemes are added in code. `*`
# matches inside one host label, for hosts like Vercel preview URLs.
# @public @type=string(minLength=1)
ALLOWED_ORIGINS=http://localhost:3001

# @type=string(minLength=40)
CREDENTIALS_ENCRYPTION_KEY=

# @public @type=url
OSRM_BASE_URL=https://router.project-osrm.org

# Header better-auth reads the client IP from for rate limiting. It must be one
# the edge proxy sets itself so clients cannot spoof it: Traefik on Dokploy
# sets x-real-ip; behind Cloudflare use cf-connecting-ip.
# @public @type=string(minLength=1)
CLIENT_IP_HEADER=x-real-ip

# Optional. Leave it empty to keep POST /api/demo/reset switched off.
# @sensitive @type=string(minLength=32) @required=false
DEMO_RESET_SECRET=

# Optional. Atomic Memory keeps each operator's reviewed route notes. Leave
# either value empty to keep route notes off. Cloud: https://api.atomicstrata.ai
# with a project API key; local Core: http://127.0.0.1:17350 with CORE_API_KEY.
# Plain string on purpose: a malformed value must switch route notes off,
# not stop the server, so the URL is checked in packages/api/src/route-notes.ts.
# @public @type=string @required=false
ATOMICMEMORY_API_URL=

# @sensitive @type=string(minLength=1) @required=false
ATOMICMEMORY_API_KEY=

# @public @type=url
TILES_API_URL=http://127.0.0.1:8080

# @public @type=url
WEATHER_API_URL=http://127.0.0.1:8788
